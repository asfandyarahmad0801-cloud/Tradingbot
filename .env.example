# Copy to .env and fill in. Never commit the real .env file.
# API keys must have TRADE + READ permission only. NEVER enable withdrawal.

TRADINGBOT_MODE=paper                # backtest | paper | live
TRADINGBOT_CONFIG_PATH=config/config.yaml

# Live/paper exchange credentials (read+trade only, no withdrawal permission)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Optional: separate read-only key set used purely for market data / scanning
EXCHANGE_READONLY_API_KEY=
EXCHANGE_READONLY_API_SECRET=

# Optional external data providers (leave blank to disable that data source)
NEWS_API_KEY=
SOCIAL_SENTIMENT_API_KEY=
ONCHAIN_DATA_API_KEY=
MACRO_CALENDAR_API_KEY=

# Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

DATABASE_URL=sqlite:///./tradingbot.db
